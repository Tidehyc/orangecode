# OrangeCode 配置示例：复制为 .env 后填入自己的值
# 配置项也可直接以同名环境变量提供，前缀为 ORANGECODE_

# 默认模型（LiteLLM 兼容格式）
ORANGECODE_DEFAULT_MODEL=deepseek/deepseek-chat

# 模型 API Key；不设置时 LiteLLM 会读取厂商各自的环境变量
# （如 OPENAI_API_KEY、DEEPSEEK_API_KEY）
ORANGECODE_API_KEY=

# 可选：自定义端点（自建网关 / 代理）
# ORANGECODE_API_BASE=https://your-endpoint/v1

# 可选：会话与状态数据存放目录（默认 ~/.orangecode）
# ORANGECODE_STATE_DIR=~/.orangecode

# 可选：日志级别（默认 INFO）
# ORANGECODE_LOG_LEVEL=INFO
